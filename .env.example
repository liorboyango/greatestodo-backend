# Server Configuration
PORT=3001
NODE_ENV=development

# Firebase Service Account
# Set this to the full JSON string of your Firebase service account key
# In production (Render), set FIREBASE_SERVICE_ACCOUNT_JSON as an environment variable
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"your-project-id",...}'

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,https://liorboyango.github.io

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
